{
  "name": "danus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Danus (Dana Usaha) — multi-branch inventory & finance management app (React + TS + Vite + Supabase).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
