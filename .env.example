# Supabase configuration — copy this file to `.env.local` and fill with your project values.
# NEVER commit real credentials. `.env.local` is gitignored.
#
# Find these in your Supabase project: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: used only by the `npm run gen:types` script (Supabase CLI).
# SUPABASE_PROJECT_ID=your-project-ref
